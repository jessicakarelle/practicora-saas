{
  "name": "practicora-saas",
  "version": "7.4.1",
  "private": true,
  "description": "Practicora — espace professionnel pour documenter les stages, analyser la progression et produire des rapports.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "i18n:generate": "node scripts/generate-i18n-catalog.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "build": "npm run i18n:generate && next build --webpack",
    "start": "next start",
    "lint": "npm run i18n:generate && eslint . --max-warnings=0",
    "typecheck": "npm run i18n:generate && tsc --noEmit",
    "check": "npm run i18n:generate && npm run i18n:check && eslint . --max-warnings=0 && tsc --noEmit && next build --webpack"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@supabase/supabase-js": "2.110.6",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.24.0",
    "motion": "12.42.2",
    "next": "16.2.10",
    "next-themes": "0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "recharts": "3.9.2",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "prettier": "3.9.5",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3"
  }
}
